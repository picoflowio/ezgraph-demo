{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "config/*.json",
        "outDir": "dist"
      },
      {
        "include": "graphs/quote-graph/prompt/*.md",
        "outDir": "dist"
      },
      {
        "include": "graphs/quote-graph/data/**/*",
        "outDir": "dist"
      },
      {
        "include": "graphs/quote-langgraph/prompt/*.md",
        "outDir": "dist"
      },
      {
        "include": "graphs/quote-langgraph/data/**/*",
        "outDir": "dist"
      },
      {
        "include": "graphs/expense-graph/prompt/*.md",
        "outDir": "dist"
      },
      {
        "include": "graphs/expense-graph/prompt/*.json",
        "outDir": "dist"
      },
      {
        "include": "graphs/expense-graph/data/**/*",
        "outDir": "dist"
      },
      {
        "include": "graphs/decision-hotel-graph/prompt/*.md",
        "outDir": "dist"
      },
      {
        "include": "graphs/decision-hotel-graph/data/**/*",
        "outDir": "dist"
      }
    ]
  }
}
