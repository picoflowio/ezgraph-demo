PORT=8000

# Required by DemoGraph
GOOGLE_API_KEY=
GLM_API_KEY=
# Optional; defaults to Z.AI's general OpenAI-compatible API.
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Required by HotelGraph, HotelLanggrah, InvoiceGraph, SupportGraph, and the GPT-5 semantic evaluation test
OPENAI_API_KEY=

# HotelGraph's scenario test runs live when this is 1 and OPENAI_API_KEY is set.
RUN_LIVE_HOTEL_GRAPH_TEST=1
HOTEL_GRAPH_JUDGE_MODEL=gpt-4o
HOTEL_GRAPH_TEST_TIMEOUT_MS=900000

# SupportGraph's scenario test runs live when this is 1 and OPENAI_API_KEY is set.
RUN_LIVE_SUPPORT_GRAPH_TEST=1
SUPPORT_GRAPH_JUDGE_MODEL=gpt-4o
SUPPORT_GRAPH_TEST_TIMEOUT_MS=900000
# Freezes "today" so the return windows and refund amounts stay repeatable.
SUPPORT_GRAPH_CURRENT_DATE=2027-07-15T00:00:00.000Z
# SupportGraph's own session policy, applied in onRestoreSessionDoc().
SUPPORT_GRAPH_IDLE_MS=1800000
SUPPORT_GRAPH_APPROVAL_HOLD_MS=600000
ANTHROPIC_API_KEY=
SESSION_EXPIRATION=50000

# mongodb, sqlite, cosmos, or memory (tests only)
SESSION_STORE=sqlite
SQLITE_DB_PATH=./data/sessions.sqlite

# Required only when SESSION_STORE=cosmos
AZURE_TENANT_ID=
COSMO_DB_CLIENT_ID=
COSMO_DB_CLIENT_SECRET=
COSMO_ENDPOINT=https://your-account.documents.azure.com:443/
COSMO_DB_ID=langgraph
COSMO_DB_SESSION_CONTAINER_ID=sessions
COSMOS_THROUGHPUT=400

# Required when SESSION_STORE=mongodb or when running either test2 hotel test
MONGODB_URL=mongodb://localhost:27017
MONGODB_NAME=ezgraph
MONGODB_COLLECTION=sessions
