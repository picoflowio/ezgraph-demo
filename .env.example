PORT=8000

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=

# mongodb, sqlite, cosmos, or memory (tests only)
SESSION_STORE=sqlite
SQLITE_DB_PATH=./data/sessions.sqlite

# Required only when SESSION_STORE=cosmos
# Key authentication: set COSMODB_KEY; otherwise use a service principal below
# or configure the application's DefaultAzureCredential sources.
COSMODB_KEY=
COSMOS_CREATE_IF_NOT_EXISTS=true
COSMO_ENDPOINT=https://your-account.documents.azure.com:443/
AZURE_TENANT_ID=
COSMO_DB_CLIENT_ID=
COSMO_DB_CLIENT_SECRET=
COSMO_DB_ID=ezgraph
COSMO_DB_SESSION_CONTAINER_ID=sessions
COSMOS_THROUGHPUT=400

# Required when SESSION_STORE=mongodb or when running test2:quote-langgraph
MONGODB_URL=mongodb://localhost:27017
MONGODB_NAME=ezgraph
MONGODB_COLLECTION=sessions
# Optional CA bundle for deployments such as AWS DocumentDB.
MONGODB_TLS_CA_FILE=
